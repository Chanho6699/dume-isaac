# --- Isaac Sim / Isaac Lab local files ---
# Isaac Lab convention: symlink to the local Isaac Sim install
_isaac_sim
# Omniverse / Kit caches and thumbnails
.thumbs/
.nvidia-omniverse/
kit_cache/
*.usd.lock
*.usda.lock
# Converter scratch output. Put generated/intermediate USD under a `_generated/`
# directory; promote a small final USD out of it explicitly when it should be tracked.
# (Do NOT blanket-ignore *.usd / *.urdf — curated assets may be committed later.)
**/_generated/
*.usd.bak
*.usda.bak

# my_so101: upstream files fetched by scripts/script02_fetch_so101_source.py (pinned +
# sha256 in source_manifest.yaml, ~16 MB) and the USD generated by script04.
# Remove these lines if you decide to commit them (Apache-2.0 upstream; LICENSE is fetched too).
dume_isaac/assets/my_so101/urdf/*
!dume_isaac/assets/my_so101/urdf/README.md
dume_isaac/assets/my_so101/usd/*
!dume_isaac/assets/my_so101/usd/README.md

# --- OS / editor junk ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
